{
  "schemaVersion": 1,
  "id": "housenimble.flight",
  "name": "Flight · fly i nærheden",
  "description": "Live fly med interaktivt kort, valg af fly og flyselskabslogoer. Core håndterer afgrænset HTTPS, PNG-visning og cache.",
  "version": "0.2.0",
  "apiVersion": 1,
  "runtime": "lua-5.4",
  "entry": "main.lua",
  "license": "MIT",
  "boards": [
    "esp32-p4"
  ],
  "permissions": {
    "network": [
      "https://opendata.adsb.fi",
      "https://tile.openstreetmap.org",
      "https://raw.githubusercontent.com"
    ],
    "mqttSubscribe": [],
    "mqttPublish": [],
    "storageBytes": 0
  },
  "limits": {
    "memoryBytes": 262144,
    "instructionsPerCallback": 100000,
    "packageBytes": 131072
  }
}
